# Configurazione centralizzata per tutte le pipeline BUSINESS e CONSUMER.
# Copiare questo file in SCRIPT/.env e valorizzare i campi sensibili.
# Non inserire mai il file SCRIPT/.env in repository o archivi condivisi.

# -----------------------------------------------------------------------------
# CRM IN CLOUD - REPORTISTICA BUSINESS
# -----------------------------------------------------------------------------
# Chiave usata dalla pipeline BUSINESS/14_ELABORA_CB.
CRM_REPORTISTICA_API_KEY_CB=
# Chiave usata dalle estrazioni e dai forecast BUSINESS (ordini, opportunita,
# appuntamenti e forecast).
CRM_REPORTISTICA_API_KEY_FCST=
# URL base delle API CRM in Cloud. Modificarlo solo in caso di cambio endpoint.
CRM_REPORTISTICA_BASE_URL=https://app.crmincloud.it/api/v1

# -----------------------------------------------------------------------------
# MICROSOFT GRAPH - INVIO EMAIL
# -----------------------------------------------------------------------------
# Credenziali dell'applicazione Azure/Entra usata per inviare email tramite
# Microsoft Graph. Il tenant deve essere un GUID; il client secret e' sensibile.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
GRAPH_CLIENT_SECRET=
# Casella abilitata come mittente per le automazioni Graph.
GRAPH_SENDER_EMAIL=reportistica@mywaysrl.it
# Object ID del Service Principal dell'applicazione Azure/Entra.
SERVICE_PRINCIPAL_OBJECT_ID=

# -----------------------------------------------------------------------------
# BUSINESS/14_ELABORA_CB - DESTINATARI E MODALITA DI ESECUZIONE
# -----------------------------------------------------------------------------
# Elenco destinatari separati da punto e virgola, senza spazi obbligatori.
GOVERNANCE_EMAIL=a.bitetto@mywaysrl.it;stage@mywaysrl.it;p.pellegata@mywaysrl.it;b.tissino@mywaysrl.it;l.mattaini@mywaysrl.it;g.mandelli@mywaysrl.it;c.febbo@mywaysrl.it
# true: simula le scritture CRM; false: esegue realmente le modifiche.
CRM_DRY_RUN=false
# true: prepara il messaggio senza inviarlo; false: invia realmente l'email.
EMAIL_DRY_RUN=true
# Numero massimo di record CRM da elaborare nei test. Vuoto = nessun limite.
CRM_TEST_LIMIT=
# true: esecuzione CB rapida; false: flusso completo con storico e log.
CB_RAPIDA=false

# -----------------------------------------------------------------------------
# CONSUMER/12_CRUSCOTTO_PISTA_CONSUMER
# -----------------------------------------------------------------------------
# Elenco destinatari email separati da punto e virgola.
CONSUMER_EMAIL_DESTINATARI=a.grisoli@mywaysrl.it;a.bitetto@mywaysrl.it;g.mandelli@mywaysrl.it;giulia.soffiato@vodafone.com;paola.tobaldo@fastweb.it
# true: salva il report localmente senza upload, email o eliminazione dei RAW.
# false: esegue il flusso reale completo.
CONSUMER_TEST_RUN=false

# -----------------------------------------------------------------------------
# MICROSOFT GRAPH - SHAREPOINT
# -----------------------------------------------------------------------------
# Credenziali dell'applicazione Azure/Entra dedicata a SharePoint.
SHAREPOINT_GRAPH_CLIENT_ID=
SHAREPOINT_GRAPH_TENANT_ID=
SHAREPOINT_GRAPH_CLIENT_SECRET=

# RISORSE SHAREPOINT CONDIVISE
# tenant SharePoint comune
SHAREPOINT_HOSTNAME=mywaysrl.sharepoint.com

# sito e raccolta documentale 00_SCAMBIO DOCUMENTI
SHAREPOINT_SCAMBIO_SITE_PATH=/sites/00_SCAMBIODOCUMENTI
SHAREPOINT_SCAMBIO_LIBRARY_NAME=Shared Documents

# sito e raccolta del progetto MyWay Tools
SHAREPOINT_MYWAY_TOOLS_SITE_PATH=/sites/MyWayTools
SHAREPOINT_MYWAY_TOOLS_LIBRARY_NAME=Shared Documents

# cartella dei file RAW condivisi dalle pipeline Consumer
SHAREPOINT_RAW_FOLDER=MyWay Tools/SCRIPT/00_RAW_FILE

# cruscotto giornaliero Consumer
SHAREPOINT_CONSUMER_DAILY_REPORT_FOLDER=00_SCAMBIO DOCUMENTI/01_CONSUMER/CRUSCOTTO GIORNALIERO

# cartella .parquet condivisa da Gara, Opportunita, Appuntamenti e FCST
SHAREPOINT_SCAMBIO_PARQUET_FOLDER=00_SCAMBIO DOCUMENTI/.parquet

# basi dati Excel Business e relativi storici
SHAREPOINT_BUSINESS_BASI_DATI_FOLDER=00_SCAMBIO DOCUMENTI/00_BUSINESS/BASI_DATI_xlsx

# cartella della pipeline CB Business
SHAREPOINT_BUSINESS_CB_FOLDER=00_SCAMBIO DOCUMENTI/00_BUSINESS/CB

# basi dati Excel Consumer
SHAREPOINT_CONSUMER_BASI_DATI_FOLDER=00_SCAMBIO DOCUMENTI/01_CONSUMER/BASI_DATI_xlsx

# SITI DEI NEGOZI
# raccolta documentale comune ai siti dei negozi
SHAREPOINT_NEGOZI_LIBRARY_NAME=Documents

# percorsi dei singoli siti
SHAREPOINT_FIDENZA_SITE_PATH=/sites/...
SHAREPOINT_GALASSIA_SITE_PATH=/sites/...
SHAREPOINT_TORRI_SITE_PATH=/sites/...
SHAREPOINT_EUROSIA_SITE_PATH=/sites/...
SHAREPOINT_SASSUOLO_SITE_PATH=/sites/...
SHAREPOINT_CARPI_SITE_PATH=/sites/...
SHAREPOINT_BONIFACIO_SITE_PATH=/sites/...
SHAREPOINT_MARANELLO_SITE_PATH=/sites/...

# SITI E CARTELLE CONSUMER CONDIVISI
# siti di destinazione dei report Consumer
SHAREPOINT_TEAM_CONSUMER_SITE_PATH=/sites/TEAMCONSUMER
SHAREPOINT_CONSUMER_MANDELLI_SITE_PATH=/sites/CONSUMER-MANDELLI

# raccolta documentale comune ai siti Consumer
SHAREPOINT_CONSUMER_LIBRARY_NAME=Documents

# destinazione del cruscotto aggregativo; vuoto indica la radice
SHAREPOINT_CRUSCOTTO_AGGREGATIVO_OUTPUT_FOLDER=

# -----------------------------------------------------------------------------
# CONSUMER/13_REPORT_GIACENZE
# -----------------------------------------------------------------------------
# true: crea il report locale senza eliminare il RAW da SharePoint.
# false: abilita la finalizzazione reale prevista dalla pipeline.
GIACENZE_TEST_RUN=false
