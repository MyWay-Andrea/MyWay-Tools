GRAPH_CLIENT_ID=inserisci_client_id
GRAPH_TENANT_ID=inserisci_tenant_id
GRAPH_CLIENT_SECRET=inserisci_client_secret
GRAPH_SENDER_EMAIL=reportistica@mywaysrl.it

# Separare piu destinatari con punto e virgola.
CONSUMER_EMAIL_DESTINATARI=destinatario@dominio.it

# true: salva in output senza upload, email o eliminazione RAW; false: esecuzione reale.
CONSUMER_TEST_RUN=true

# Microsoft Graph - applicazione dedicata a SharePoint.
SHAREPOINT_GRAPH_CLIENT_ID=inserisci_client_id
SHAREPOINT_GRAPH_TENANT_ID=inserisci_tenant_id
SHAREPOINT_GRAPH_CLIENT_SECRET=inserisci_client_secret

# Destinazione del Cruscotto Consumer su SharePoint.
SHAREPOINT_HOSTNAME=mywaysrl.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/00_SCAMBIODOCUMENTI
SHAREPOINT_LIBRARY_NAME=Shared Documents
SHAREPOINT_OUTPUT_FOLDER=00_SCAMBIO DOCUMENTI/CONSUMER/CRUSCOTTO GIORNALIERO

# Origine remota dei file RAW.
SHAREPOINT_RAW_HOSTNAME=mywaysrl.sharepoint.com
SHAREPOINT_RAW_SITE_PATH=/sites/MyWayTools
SHAREPOINT_RAW_LIBRARY_NAME=Shared Documents
SHAREPOINT_RAW_FOLDER=MyWay Tools/SCRIPT/00_RAW_FILE
